# =============================================================================
# DMF Workpiece Tracking Dashboard — environment configuration
# Copy to `.env` (git-ignored) and adjust. Docker Compose reads this file
# automatically; the backend reads the same variable names.
# =============================================================================

# --- Docker Compose ------------------------------------------------------------
# Port on the host where the dashboard (nginx: frontend + /api + /ws) is served.
HTTP_PORT=8080
# Bind address for HTTP_PORT (127.0.0.1 = only this computer, 0.0.0.0 = whole lab network).
HTTP_BIND=0.0.0.0

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=dmf
POSTGRES_USER=dmf
# CHANGE THIS for any shared installation.
POSTGRES_PASSWORD=change-me
# The backend's connection string (Compose builds it from the values above).
# For running the backend outside Docker:
# DATABASE_URL=postgresql+asyncpg://dmf:change-me@localhost:5432/dmf
DB_RUN_MIGRATIONS=true
# Events kept in memory while the database is unreachable (oldest dropped beyond this).
DB_BUFFER_MAX=200000
# Database connections of the backend (plus the same number as overflow).
DB_POOL_SIZE=5
DB_RETRY_MAX_S=30
# Alembic config used for the automatic migrations (the Docker image sets /app/database/alembic.ini).
# ALEMBIC_INI_PATH=database/alembic.ini

# --- OPC UA (strictly READ-ONLY) ------------------------------------------------
# Plant server from the PLC project. Requires laboratory verification (docs/08-lab-validation.md).
OPCUA_ENDPOINT=opc.tcp://192.168.0.10:4840
# Optional user (a read-only OPC UA user is recommended). Empty = anonymous.
OPCUA_USERNAME=
OPCUA_PASSWORD=
# Optional security: "Policy,Mode,client_cert,client_key[,server_cert]", e.g.
# Basic256Sha256,SignAndEncrypt,/certs/client.der,/certs/client.pem   Empty = no security.
# Keep the files in ./certs (git- and docker-ignored, NOT in ./config, which is copied into the
# image) and mount them with a docker-compose.override.yml:
#   services: { backend: { volumes: ["./certs:/certs:ro"] } }
OPCUA_SECURITY=
OPCUA_TIMEOUT_S=4
OPCUA_PUBLISHING_INTERVAL_MS=100
OPCUA_SAMPLING_INTERVAL_MS=50
# Values queued per node on the server between publishes (keeps fast 3->4->0 sequences).
OPCUA_QUEUE_SIZE=10
# Also subscribe to the 144 sensor bits (used for cross-checks only).
OPCUA_SUBSCRIBE_SENSORS=true
OPCUA_RECONNECT_MIN_S=1
OPCUA_RECONNECT_MAX_S=30
# Compare browse names of all nodes with config/opcua_nodes.yaml after connecting (reported in /api/status).
OPCUA_VALIDATE_NODES=true
# false = run without a factory connection (history browsing only).
OPCUA_ENABLED=true
# Max. OPC UA notifications waiting for the tracker; when full the client reconnects and resyncs.
EVENT_QUEUE_MAX=100000

# --- Tracking ------------------------------------------------------------------------
# Max. time between "piece left conveyor A" and "piece arrived on conveyor B" to count as one hand-over.
HANDOVER_WINDOW_S=8
# A piece waiting at a cell exit (or a turntable waiting for a route) longer than this is "stuck".
STUCK_AFTER_S=120
# How far (conveyors) a piece may have moved during a data gap and still be re-identified.
RECONCILE_MAX_HOPS=6
TICK_INTERVAL_S=1
# How often the tracker state is saved for restarts.
SNAPSHOT_INTERVAL_S=10

# --- Offline detection ------------------------------------------------------------
# off        : a cell is offline when the server is unreachable or its values are Bad
# timestamps : additionally, when its lamp value's SourceTimestamp is older than OFFLINE_AFTER_S
#              (only enable after verifying in the lab that the timestamps refresh)
OFFLINE_DETECTION=off
OFFLINE_AFTER_S=60
OFFLINE_CHECK_INTERVAL_S=10

# --- Backend / API ---------------------------------------------------------------------
LOG_LEVEL=INFO
# json (production, one JSON object per line) or text
LOG_FORMAT=json
# Timezone for "day" filters and exports (the UI uses the same timezone).
TIMEZONE=Europe/Berlin
# Header badge: live (plant) | demo | replay (mock server)
SOURCE_LABEL=live
# Only needed when the frontend is served from another origin (comma separated). Also the
# list of extra browser origins allowed to open the WebSocket (e.g. https://dmf.lab.example
# when an outside reverse proxy rewrites the Host header).
CORS_ORIGINS=
WS_MAX_RATE_HZ=4
# Concurrent WebSocket clients; more are closed with code 1013 ("try again later").
WS_MAX_CLIENTS=50
EXPORT_MAX_DAYS=31
HISTORY_PAGE_MAX=200
# Config files (paths inside the container; mounted read-only from ./config).
# PLANT_CONFIG_PATH=/app/config/plant.yaml
# NODES_CONFIG_PATH=/app/config/opcua_nodes.yaml

# --- Mock OPC UA server (Compose profile "demo" only; TEST/DEMO TOOLING) ------------
MOCK_MODE=demo
MOCK_SPEED=1
# MOCK_REPLAY_FILE=/recordings/lab-run.jsonl
# HTTP control API of the mock for end-to-end tests (0 = off). TEST ONLY, never in production.
# MOCK_CONTROL_PORT=0
